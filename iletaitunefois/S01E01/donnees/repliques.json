   "ordre": 1,
   "locuteur": "ELIO",
   "didascalie": "off",
   "voix_off": true,
   "texte": "Et la vapeur ?",
   "statut": "propose",
   "_note": "révision du 29 août 2026, en attente de la signature de Guillaume",
   "empreinte": "9eeab52d93c1bd5f"
