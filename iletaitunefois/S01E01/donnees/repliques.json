  {
   "adresse": "S01E01/plan-53/ligne-0",
   "plan": 53,
   "ordre": 0,
   "locuteur": "ELIO",
   "didascalie": null,
   "voix_off": false,
   "texte": "Faux : premier pont de fer occidental en 1801, le pont de Menai en 1826. 25 ans, pas 500.",
