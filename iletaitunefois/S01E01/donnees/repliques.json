   "locuteur": "SAM",
   "didascalie": "off",
   "voix_off": true,
   "texte": "Déjà sortie de la liste. Bien essayé.",
   "statut": "propose",
   "_note": "révision du 29 août 2026, en attente de la signature de Guillaume",
   "empreinte": "a9deb925e0952e73"
